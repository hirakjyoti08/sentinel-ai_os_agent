# AI OS Agent - Environment Variables
# Copy this to .env and fill in your API keys

# Primary LLM (NVIDIA Nemotron) - Get from https://build.nvidia.com
NVIDIA_API_KEY=PASTE_YOUR_NVIDIA_KEY_HERE
# Optional: Override model (default: nvidia/nemotron-3-ultra-550b-a55b)
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Fallback LLM (Google Gemini) - Get from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM (Groq) - Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO